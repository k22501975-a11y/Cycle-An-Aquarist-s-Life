{
  "name": "cycle-an-aquarists-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json && tsc --noEmit -p tsconfig.simsvc.json && tsc --noEmit -p tsconfig.e2e.json",
    "build:sim": "vite build --config vite.simsvc.config.ts",
    "sim": "node dist-sim/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "android": "npm run build && cap sync android",
    "lint": "eslint . --max-warnings 0",
    "e2e": "playwright test",
    "check:assets": "node scripts/check-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:assets",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "pixi.js": "^8.22.0"
  }
}
