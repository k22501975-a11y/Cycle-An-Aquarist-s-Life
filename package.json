{
  "name": "cycle-an-aquarists-life",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json && tsc --noEmit -p tsconfig.simsvc.json",
    "build:sim": "vite build --config vite.simsvc.config.ts",
    "sim": "node dist-sim/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "android": "npm run build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "pixi.js": "^8.22.0"
  }
}
